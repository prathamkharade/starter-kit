# Copy to infra/.env.prod ON THE SERVER (chmod 600). Never commit the real file.
# Compose-level variables (also read from infra/.env): DOMAIN, ACME_EMAIL, REGISTRY, TAG
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
REGISTRY=ghcr.io/your-org/app
TAG=latest

APP_ENV=production
APP_NAME=App
PUBLIC_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
LOG_LEVEL=info

POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://app:change-me-long-random@db:5432/app?sslmode=disable
DB_MAX_CONNS=20

# generate with: docker run --rm ghcr.io/your-org/app/api:latest secrets
JWT_SECRET=
DATA_ENC_KEY=
DATA_INDEX_KEY=

WORKER_CONCURRENCY=2

EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=App <no-reply@app.example.com>

SMS_PROVIDER=none

S3_ENDPOINT=<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=app-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=

MEDIA_VIDEO_PRESET=medium

TERMS_VERSION=2026-01-01
PRIVACY_VERSION=2026-01-01
