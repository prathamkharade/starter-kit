# PUBLIC client config for production builds (--dart-define=ENV=prod). No secrets.
# Empty API_BASE_URL on web = same origin as the website (Caddy proxies /v1 → API),
# which keeps the refresh cookie first-party and avoids CORS preflights.
APP_NAME=App
API_BASE_URL=
API_BASE_URL_MOBILE=https://app.example.com
PRIVACY_URL=https://app.example.com/privacy
TERMS_URL=https://app.example.com/terms
SUPPORT_EMAIL=support@example.com
