# PUBLIC client config. This file is shipped inside the app/website — anyone can read it.
# NEVER put secrets here (API keys with spend, signing keys, DB URLs...).
# Selected at build time: --dart-define=ENV=dev|prod. Any value can be overridden
# with --dart-define=KEY=value (e.g. API_BASE_URL for the Android emulator: http://10.0.2.2:8080).
APP_NAME=App
API_BASE_URL=http://localhost:8080
PRIVACY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
SUPPORT_EMAIL=support@example.com
