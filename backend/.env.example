# Backend configuration. Copy to backend/.env for local dev (task setup does this).
# Every variable is read in internal/config/config.go. In production, set these
# in infra/.env.prod (never commit real values). Generate secrets: task secrets

APP_ENV=development            # development | production | test
APP_NAME=App
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5000   # Flutter web dev server (task web)
TRUST_PROXY=false              # true behind Caddy/Cloudflare (prod compose sets it)
LOG_LEVEL=info

# --- Database (dev compose: infra/compose.dev.yml) ---
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MAX_CONNS=10

# --- Secrets: DEV-ONLY samples. Production refuses to start with these. ---
JWT_SECRET=DEV-ONLY-jwt-secret-change-me-0123456789abcdef
DATA_ENC_KEY=REVWLU9OTFktRU5DLUtFWS0wMTIzNDU2Nzg5YWJjZGU=
DATA_INDEX_KEY=REVWLU9OTFktSURYLUtFWS0wMTIzNDU2Nzg5YWJjZGU=
JWT_ISSUER=app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Worker ---
WORKER_EMBEDDED=true           # dev: run jobs inside the API process. prod: separate worker container
WORKER_CONCURRENCY=2

# --- Email: console (prints to log) | smtp ---
# Dev compose runs Mailpit: SMTP localhost:1025, inbox UI http://localhost:8025
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none                  # none | starttls (port 587) | tls (port 465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=App <no-reply@example.com>
# Production examples (pick one, see docs/COST.md):
#  Amazon SES : SMTP_HOST=email-smtp.eu-central-1.amazonaws.com SMTP_PORT=587 SMTP_TLS=starttls
#  Brevo      : SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_TLS=starttls
#  Resend     : SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_TLS=tls SMTP_USER=resend

# --- SMS: none | console | twilio | http ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic JSON gateway (MSG91, Vonage, Infobip, WhatsApp BSPs…). {{to}} and {{message}} are replaced.
SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=          # e.g. "Authorization: Bearer xxx"
SMS_HTTP_BODY={"to":"{{to}}","message":"{{message}}"}

# --- Object storage (S3-compatible). Dev: MinIO via `task infra:up:media` ---
# Leave S3_ACCESS_KEY empty to disable media endpoints.
S3_ENDPOINT=localhost:9000
S3_REGION=auto
S3_BUCKET=app-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=            # CDN/custom domain for public media, e.g. https://media.example.com
# Cloudflare R2: S3_ENDPOINT=<accountid>.r2.cloudflarestorage.com S3_USE_SSL=true S3_REGION=auto

# --- Media compression (docs/MEDIA.md) ---
MEDIA_MAX_MB=200
MEDIA_IMAGE_FORMAT=webp        # webp (all clients) | avif (smaller; browsers only — Flutter mobile can't decode)
MEDIA_IMAGE_QUALITY=72
MEDIA_VIDEO_CODEC=h264         # h264 (universal) | hevc | av1 (smallest, slowest)
MEDIA_VIDEO_CRF=28             # higher = smaller
MEDIA_VIDEO_PRESET=veryfast    # slower presets = smaller files, more CPU
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_KEEP_ORIGINAL=false

# --- Privacy / compliance (docs/compliance/) ---
TERMS_VERSION=2026-01-01
PRIVACY_VERSION=2026-01-01
SIGNUP_VIA_OTP=true            # verifying an OTP for an unknown address creates the account
ACCOUNT_DELETION_GRACE=720h    # 30 days to change their mind, then permanent erasure
AUDIT_RETENTION=8760h          # 1 year

# --- Remote app config (force update / maintenance) ---
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
MAINTENANCE_MODE=false
